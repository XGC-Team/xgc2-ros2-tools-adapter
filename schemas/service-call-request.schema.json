{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xgc.ros2.tools.v1.ServiceCallRequest",
  "type": "object",
  "properties": {
    "service": {"type": "string", "pattern": "^/[A-Za-z_][A-Za-z0-9_]*(?:/[A-Za-z_][A-Za-z0-9_]*)*$", "maxLength": 1024},
    "serviceType": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*/srv/[A-Za-z][A-Za-z0-9_]*$", "maxLength": 256},
    "request": {"type": "object"},
    "waitForServiceMs": {"type": "integer", "minimum": 0, "maximum": 60000},
    "callTimeoutMs": {"type": "integer", "minimum": 1, "maximum": 120000}
  },
  "required": ["service", "serviceType", "request", "waitForServiceMs", "callTimeoutMs"],
  "additionalProperties": false
}
